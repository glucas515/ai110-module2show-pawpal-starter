classDiagram
    class Owner {
        +name
        +preferences
    }

    class Pet {
        +name
        +species
        +owner
    }

    class Task {
        +title
        +duration_minutes
        +priority
        +pet
    }

    class Scheduler {
        +tasks
        +available_minutes
        +generate_plan()
        +explain_plan()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Task : uses
